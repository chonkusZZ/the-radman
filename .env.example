# Copy to .env and set real values. Never commit .env.
RADMAN_DB_PASSWORD=change-me-db
# Passphrase that encrypts the backup repository. Store it in your password manager, SEPARATELY from the backups.
BACKUP_PASSPHRASE=change-me-backup-passphrase
# Only if you use the standby (docker compose --profile replica up -d):
RADMAN_REPLICATION_PASSWORD=change-me-replication
# RADMAN_DATABASE_RO_URL=postgres://radman:change-me-db@db-replica:5432/radman
# BACKUP_PATH=/mnt/backup-disk          # host path for the backup repository (default: a named volume)

# Edition: msp (multi-tenant, default) or standalone (single organisation, simplified UI)
# RADMAN_MODE=msp
